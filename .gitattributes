# One line ending everywhere, so a checkout on Windows cannot turn every generated file into
# a diff against its source and fail `tools/ramps.py --check` on a change nobody made.
* text=auto eol=lf
# Vendored faces and their licence texts, byte for byte: ramps/roster.json pins their sha256, and
# IBM Plex Mono's OFL.txt ships with CRLF line endings that normalising would change.
fonts/** -text

# Generated by tools/ramps.py and tools/export.py and never edited by hand. Marking them lets
# GitHub collapse them in a pull request, so review lands on ramps/brands/ instead.
ramps/tokens/** linguist-generated=true
exports/** linguist-generated=true
examples/*/exports/** linguist-generated=true
