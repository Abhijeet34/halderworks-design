# One line ending everywhere, so a checkout on Windows cannot turn every generated file into
# a diff against the seed and fail `tools/build.py --check` on a change nobody made.
* text=auto eol=lf

# Generated by tools/build.py and tools/export.py and never edited by hand. Marking them lets
# GitHub collapse them in a pull request, so review lands on tokens/tokens.seed.json instead.
tokens/tokens.css linguist-generated=true
tokens/tokens.json linguist-generated=true
exports/** linguist-generated=true
